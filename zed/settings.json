{
    "cli_default_open_behavior": "new_window",
    "disable_ai": true,
    "auto_update": false,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false,
    },
    "redact_private_values": true,

    // Appearance
    "base_keymap": "VSCode",
    "vim_mode": false,
    "ui_font_size": 15.0,
    "ui_font_family": "0xProto Nerd Font",
    "buffer_font_size": 16.0,
    "buffer_font_family": "0xProto Nerd Font Mono",
    "agent_ui_font_family": "0xProto Nerd Font Mono",
    "agent_buffer_font_family": ".SystemUIFont",
    "agent_buffer_font_size": 15.0,
    "markdown_preview_font_family": ".SystemUIFont",
    "theme": {
        "mode": "system",
        "light": "Catppuccin Latte",
        "dark": "Catppuccin Mocha",
    },
    "icon_theme": {
        "mode": "system",
        "light": "Catppuccin Latte",
        "dark": "Catppuccin Mocha",
    },
    "auto_install_extensions": {
        "catppuccin": true,
        "catppuccin-icons": true,
        "toml": true,
        "cmake": true,
        "make": true,
    },

    // Editor
    "cursor_shape": "bar",
    "colorize_brackets": true,
    "scrollbar": { "show": "never" },
    "tab_size": 4,
    "preferred_line_length": 100,
    "wrap_guides": [100],
    "show_whitespaces": "none",
    "relative_line_numbers": "disabled",
    "hard_tabs": false,
    "use_autoclose": true,
    "linked_edits": true,
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
    },
    "diagnostics": {
        "inline": { "enabled": true },
    },
    "indent_guides": { "enabled": true, "coloring": "indent_aware" },
    "sticky_scroll": { "enabled": true },
    "semantic_tokens": "combined",
    "document_folding_ranges": "on",
    "auto_signature_help": true,
    "show_signature_help_after_edits": true,
    "use_smartcase_search": true,
    "search": { "center_on_match": true },
    "hover_popover_delay": 200,

    // Files
    "format_on_save": "modifications_if_available",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "line_ending": "prefer_lf",
    "close_on_file_delete": true,
    "autosave": "on_focus_change",
    "restore_on_startup": "last_session",
    "file_scan_exclusions": [
        "**/.git",
        "**/target",
        "**/build",
        "**/__pycache__",
        "**/.venv",
        "**/.mypy_cache",
        "**/.ruff_cache",
    ],

    // Panels
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": { "enabled": true, "delay_ms": 600 },
    },
    "tabs": { "file_icons": true, "git_status": true, "show_diagnostics": "errors" },
    "project_panel": {
        "dock": "left",
        "git_status": true,
        "auto_fold_dirs": true,
        "sticky_scroll": true,
        "show_diagnostics": "errors",
    },
    "title_bar": {
        "show_branch_status_icon": true,
        "show_onboarding_banner": false,
        "show_user_picture": false,
    },
    "terminal": {
        "font_family": "0xProto Nerd Font Mono",
        "copy_on_select": true,
    },

    "languages": {
        "Python": {
            "language_servers": ["basedpyright", "ruff", "!ty", "!pyright", "!pylsp", "!pyrefly"],
            "format_on_save": "on",
            "formatter": { "language_server": { "name": "ruff" } },
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
                "source.fixAll.ruff": true,
            },
        },
        "Rust": {
            "format_on_save": "on",
        },
        "C": {
            "language_servers": ["clangd"],
        },
        "C++": {
            "language_servers": ["clangd"],
        },
        "Markdown": {
            "remove_trailing_whitespace_on_save": false,
            "soft_wrap": "editor_width",
        },
    },

    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": { "command": "clippy" },
                "cargo": { "features": "all" },
                "procMacro": { "enable": true },
                "inlayHints": {
                    "maxLength": null,
                    "lifetimeElisionHints": { "enable": "skip_trivial", "useParameterNames": true },
                    "closureReturnTypeHints": { "enable": "always" },
                },
            },
        },
        "clangd": {
            "binary": {
                "arguments": [
                    "--background-index",
                    "--clang-tidy",
                    "--completion-style=detailed",
                    "--header-insertion=never",
                    "--function-arg-placeholders=0",
                ],
            },
        },
        "basedpyright": {
            "settings": {
                "basedpyright": {
                    "analysis": {
                        "typeCheckingMode": "standard",
                        "diagnosticMode": "openFilesOnly",
                        "autoImportCompletions": true,
                        "inlayHints": { "callArgumentNames": false },
                    },
                },
            },
        },
        "ruff": {
            "initialization_options": {
                "settings": { "lineLength": 100 },
            },
        },
    },
}
